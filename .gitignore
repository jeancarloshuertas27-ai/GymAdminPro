.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example
*.pem
*.key
*.cert

# Compilación y producción
dist/
dist-ssr/
build/
coverage/
.wrangler/
*.local

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

