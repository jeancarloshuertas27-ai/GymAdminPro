# Puerto del servidor Backend (opcional, por defecto 3001)
PORT=3001

# Clave de API de Google Gemini (obligatoria para el módulo "Ayuda con IA" del Sitio Miembro)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Google Gemini (opcional, por defecto gemini-3.8-flash con autodetección automática si no existe)
GEMINI_MODEL=gemini-3.8-flash
