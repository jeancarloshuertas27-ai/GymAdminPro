{
  "name": "gymadminpro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "build:admin": "vite build --mode admin --outDir dist-admin",
    "build:recepcion": "vite build --mode recepcion --outDir dist-recepcion",
    "build:miembro": "vite build --mode miembro --outDir dist-miembro",
    "build:all": "npm run build:admin && npm run build:recepcion && npm run build:miembro",
    "deploy:worker": "wrangler deploy",
    "deploy:admin": "wrangler deploy --env admin",
    "deploy:recepcion": "wrangler deploy --env recepcion",
    "deploy:miembro": "wrangler deploy --env miembro",
    "preview": "vite preview",
    "db:seed": "node server/seed.js",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "hono": "^4.13.19",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
